---
import { Code } from "astro:components";
import ImageZoom from "astro-image-zoom/ImageZoom.astro";
import Photo from "@components/Photo.astro";
import type { PhotoName } from "@data/photos";

interface Props {
  images: Exclude<PhotoName, "blueMarble">[];
}

const { images } = Astro.props;

// Starting values of the controls: the ranges at the defaults of the overlay, the colors at a dark
// theme in the accent of the site. Nothing is applied until a control changes
const colors = [
  { name: "--zoom-bg", label: "Background", value: "#050814" },
  { name: "--zoom-close-color", label: "Close icon", value: "#ff7a66" },
  { name: "--zoom-close-bg", label: "Close button", value: "#1b2238" },
  { name: "--zoom-nav-color", label: "Arrow icons", value: "#ff7a66" },
  { name: "--zoom-nav-bg", label: "Arrow buttons", value: "#1b2238" },
  { name: "--zoom-caption-color", label: "Caption text", value: "#050814" },
  { name: "--zoom-caption-bg", label: "Caption box", value: "#ff7a66" },
];

// phone: the default of the overlay up to 640px wide, where its controls get smaller
const ranges: {
  name: string;
  label: string;
  min: number;
  max: number;
  step: number;
  value: number;
  unit: string;
  phone?: number;
}[] = [
  {
    name: "--zoom-padding",
    label: "Padding",
    min: 0,
    max: 96,
    step: 4,
    value: 0,
    unit: "px",
  },
  {
    name: "--zoom-image-radius",
    label: "Image corners",
    min: 0,
    max: 40,
    step: 2,
    value: 0,
    unit: "px",
  },
  {
    name: "--zoom-button-size",
    label: "Button size",
    min: 32,
    max: 64,
    step: 2,
    value: 40,
    phone: 36,
    unit: "px",
  },
  {
    name: "--zoom-button-radius",
    label: "Button corners",
    min: 0,
    max: 32,
    step: 2,
    value: 32,
    unit: "px",
  },
  {
    name: "--zoom-controls-offset",
    label: "Distance to the edges",
    min: 0,
    max: 64,
    step: 4,
    value: 16,
    phone: 12,
    unit: "px",
  },
  {
    name: "--zoom-animation-duration",
    label: "Duration",
    min: 100,
    max: 1200,
    step: 50,
    value: 300,
    unit: "ms",
  },
];
---

<css-playground class="playground wide">
  <form class="controls" aria-label="Zoom playground">
    <div class="controls-head">
      <p>Change a value, then open a photo.</p>
      <button type="reset">Reset</button>
    </div>

    <fieldset class="colors">
      <legend>Colors</legend>
      {colors.map(({ name, label, value }) => (
        <label class="color">
          <input type="color" name={name} value={value} />
          <span class="name">
            {label}
            <code>{name}</code>
          </span>
        </label>
      ))}
    </fieldset>

    <fieldset class="ranges">
      <legend>Layout and motion</legend>
      {ranges.map(({ name, label, min, max, step, value, unit, phone }) => (
        <label class="range">
          <span class="name">
            {label}
            <code>{name}</code>
          </span>
          <input
            type="range"
            name={name}
            min={min}
            max={max}
            step={step}
            value={value}
            data-unit={unit}
            data-phone={phone}
          />
          <output data-default={`${value}${unit}`}>{`${value}${unit}`}</output>
        </label>
      ))}
    </fieldset>

    <fieldset class="prop">
      <legend>Caption</legend>
      <label>
        <input type="radio" name="captionPosition" value="bottom" checked />{" "}
        Bottom
      </label>
      <label>
        <input type="radio" name="captionPosition" value="top" /> Top
      </label>
      <label>
        <input type="checkbox" name="showCaption" checked /> Shown
      </label>
    </fieldset>

    <fieldset class="prop">
      <legend>Navigation</legend>
      <label>
        <input type="radio" name="navigationLayout" value="bar" checked /> Bar
      </label>
      <label>
        <input type="radio" name="navigationLayout" value="sides" /> Sides
      </label>
      <label>
        <input type="checkbox" name="showCounter" checked /> Counter
      </label>
    </fieldset>
  </form>

  <div class="preview">
    <!-- The variables go on this element, around the gallery: only this gallery changes -->
    <div class="scope">
      <ImageZoom>
        <div class="photos">
          {images.map((name) => (
            <Photo
              name={name}
              width={322}
              height={242}
              sizes="(min-width: 48rem) 322px, 42vw"
              caption={false}
            />
          ))}
        </div>
      </ImageZoom>
    </div>
    <!-- Rendered by Shiki in the theme of every code block; the script only swaps its text -->
    <Code
      class="snippet"
      code="/* Change a value to see the code */"
      lang="css"
      theme="github-dark-default"
    />
  </div>
</css-playground>

<script>
  // Mirrors each changed control into a CSS variable on the element around the gallery, and the
  // caption and navigation controls into the props (data attributes) of its <astro-image-zoom>
  const PROPS = {
    captionPosition: {
      attribute: "imageZoomCaptionPosition",
      initial: "bottom",
    },
    showCaption: { attribute: "imageZoomShowCaption", initial: "true" },
    navigationLayout: {
      attribute: "imageZoomNavigationLayout",
      initial: "bar",
    },
    showCounter: { attribute: "imageZoomShowCounter", initial: "true" },
  } as const;

  class CssPlayground extends HTMLElement {
    private changed = new Map<string, string>();
    // The breakpoint of overlay.css where the buttons and the offset of the overlay get smaller
    private phone = matchMedia("(max-width: 640px)");

    private get form() {
      return this.querySelector("form")!;
    }

    private get scope() {
      return this.querySelector<HTMLElement>(".scope")!;
    }

    private get zoom() {
      return this.scope.querySelector<HTMLElement>("astro-image-zoom")!;
    }

    connectedCallback() {
      this.form.addEventListener("input", this.handleInput);
      this.form.addEventListener("reset", this.handleReset);
      this.phone.addEventListener("change", this.showDefaults);
      this.showDefaults();
    }

    disconnectedCallback() {
      this.form.removeEventListener("input", this.handleInput);
      this.form.removeEventListener("reset", this.handleReset);
      this.phone.removeEventListener("change", this.showDefaults);
    }

    // The sliders the user has not moved show the default of the overlay for this screen
    private showDefaults = () => {
      for (const input of this.form.querySelectorAll<HTMLInputElement>(
        "input[data-phone]",
      )) {
        if (this.changed.has(input.name)) continue;
        input.value = this.phone.matches
          ? input.dataset.phone!
          : input.defaultValue;
        const output = input.parentElement?.querySelector("output");
        if (output) output.value = input.value + (input.dataset.unit ?? "");
      }
    };

    private handleInput = (event: Event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement)) return;

      if (input.name in PROPS) {
        const { attribute } = PROPS[input.name as keyof typeof PROPS];
        this.zoom.dataset[attribute] =
          input.type === "checkbox" ? String(input.checked) : input.value;
      } else {
        const value = input.value + (input.dataset.unit ?? "");
        this.changed.set(input.name, value);
        this.scope.style.setProperty(input.name, value);
        const output = input.parentElement?.querySelector("output");
        if (output) output.value = value;
      }
      this.render();
    };

    private handleReset = () => {
      for (const name of this.changed.keys())
        this.scope.style.removeProperty(name);
      this.changed.clear();
      for (const { attribute, initial } of Object.values(PROPS))
        this.zoom.dataset[attribute] = initial;
      for (const output of this.form.querySelectorAll("output"))
        output.value = output.dataset.default ?? "";
      // The form puts the sliders back after this event: set the ones of this screen then
      requestAnimationFrame(this.showDefaults);
      this.render();
    };

    // The code to copy: the changed variables in a class, and the props that differ from the defaults
    private render() {
      const { dataset } = this.zoom;
      const props = [
        dataset.imageZoomCaptionPosition === "top"
          ? ' captionPosition="top"'
          : "",
        dataset.imageZoomShowCaption === "false" ? " showCaption={false}" : "",
        dataset.imageZoomNavigationLayout === "sides"
          ? ' navigationLayout="sides"'
          : "",
        dataset.imageZoomShowCounter === "false" ? " showCounter={false}" : "",
      ].join("");
      const css = this.changed.size
        ? `.gallery {\n${[...this.changed].map(([name, value]) => `  ${name}: ${value};`).join("\n")}\n}`
        : "";
      // The variables go on the component through a class, so the code works as it is
      const markup =
        css || props
          ? `<ImageZoom${css ? ' class="gallery"' : ""}${props}>`
          : "";
      this.querySelector(".snippet code")!.textContent =
        [css, markup].filter(Boolean).join("\n\n") ||
        "/* Change a value to see the code */";
    }
  }

  customElements.define("css-playground", CssPlayground);
</script>

<style>
  @layer components {
    /*
     * Phones: the photos first, kept in view while the controls scroll, then the controls and the
     * code. From 48rem: the controls on the left, the photos and the code in view on the right
     */
    .playground {
      display: grid;
      grid-template-areas: "photos" "controls" "code";
      gap: 1.25rem;
      padding: clamp(1rem, 3vw, 1.75rem);
      font-size: 0.875rem;
      background: var(--color-surface);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);

      @media (width >= 48rem) {
        grid-template-areas: "controls preview";
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 2rem;
      }
    }

    .controls {
      grid-area: controls;
      display: grid;
      gap: 1.25rem;
      align-content: start;
      min-inline-size: 0;
    }

    .controls-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem 1rem;

      p {
        margin: 0;
        color: var(--color-text-muted);
      }
    }

    fieldset {
      min-inline-size: 0;
      margin: 0;
      padding: 0;
      border: 0;
    }

    legend {
      margin-block-end: 0.5rem;
      padding: 0;
      font-weight: 700;
      font-variation-settings: var(--heading-width);
    }

    /* The label, with its variable in small print under it */
    .name {
      display: grid;
      min-inline-size: 0;
      line-height: 1.3;

      /* Plain small print, not the boxed inline code of the page */
      code {
        padding: 0;
        font-size: 0.75rem;
        color: var(--color-text-muted);
        background: none;
        border: 0;
        overflow-wrap: anywhere;
      }
    }

    .colors {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
      gap: 0.625rem 1rem;
    }

    .color {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      cursor: pointer;
    }

    input[type="color"] {
      flex: none;
      inline-size: 2.25rem;
      block-size: 1.75rem;
      padding: 0.125rem;
      background: var(--color-bg);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
      cursor: pointer;
    }

    /* One row per range: the name, the slider and the value */
    .ranges {
      display: grid;
      gap: 0.625rem;
    }

    .range {
      display: grid;
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) 4.5ch;
      align-items: center;
      gap: 0.75rem;
    }

    input[type="range"] {
      inline-size: 100%;
      min-inline-size: 0;
      margin: 0;
    }

    output {
      font-variant-numeric: tabular-nums;
      text-align: end;
    }

    /* A prop on one row: its name, then its options */
    .prop {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.375rem 1.25rem;

      legend {
        float: inline-start;
        min-inline-size: 6rem;
        margin: 0;
      }

      label {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        cursor: pointer;
      }
    }

    button {
      padding: 0.375rem 0.875rem;
      color: var(--color-text);
      background: var(--color-bg);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
      cursor: pointer;

      &:hover {
        border-color: var(--color-text-muted);
      }
    }

    /* On phones the preview's children join the grid of the playground: see its areas */
    .preview {
      display: contents;

      @media (width >= 48rem) {
        grid-area: preview;
        display: grid;
        gap: 1rem;
        align-content: start;
        align-self: start;
        min-inline-size: 0;
        position: sticky;
        top: var(--sticky-top);
      }
    }

    .scope {
      min-inline-size: 0;

      /* Kept in view under the site header while the controls scroll */
      @media (width < 48rem) {
        grid-area: photos;
        position: sticky;
        top: var(--header-offset);
        z-index: 1;
        margin: -0.5rem -0.5rem 0;
        padding: 0.5rem;
        background: var(--color-surface);
      }
    }

    .photos {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;

      /* Short strips on phones, so the sticky photos leave room for the controls */
      @media (width < 48rem) {
        gap: 0.5rem;

        :global(img) {
          block-size: 5.5rem;
          object-fit: cover;
        }
      }
    }

    .snippet {
      margin: 0;

      @media (width < 48rem) {
        grid-area: code;
      }
    }
  }
</style>
