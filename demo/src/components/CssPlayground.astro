---
import ImageZoom from "astro-image-zoom/ImageZoom.astro";
import Photo from "@components/Photo.astro";
import type { PhotoName } from "@data/photos";

interface Props {
  images: Exclude<PhotoName, "blueMarble">[];
}

const { images } = Astro.props;

// Starting values of the controls; nothing is applied until a control changes
const colors = [
  { name: "--zoom-bg", label: "Background", value: "#050814" },
  { name: "--zoom-close-color", label: "Close icon", value: "#ffb454" },
  { name: "--zoom-close-bg", label: "Close button", value: "#1b2238" },
  { name: "--zoom-nav-color", label: "Arrow icons", value: "#ffb454" },
  { name: "--zoom-nav-bg", label: "Arrow buttons", value: "#1b2238" },
  { name: "--zoom-caption-color", label: "Caption text", value: "#050814" },
  { name: "--zoom-caption-bg", label: "Caption box", value: "#ffb454" },
];

const ranges = [
  {
    name: "--zoom-padding",
    label: "Padding",
    min: 0,
    max: 96,
    step: 4,
    value: 0,
    unit: "px",
  },
  {
    name: "--zoom-image-radius",
    label: "Image corners",
    min: 0,
    max: 40,
    step: 2,
    value: 0,
    unit: "px",
  },
  {
    name: "--zoom-button-size",
    label: "Button size",
    min: 32,
    max: 64,
    step: 2,
    value: 44,
    unit: "px",
  },
  {
    name: "--zoom-button-radius",
    label: "Button corners",
    min: 0,
    max: 32,
    step: 2,
    value: 32,
    unit: "px",
  },
  {
    name: "--zoom-controls-offset",
    label: "Distance to the edges",
    min: 0,
    max: 64,
    step: 4,
    value: 20,
    unit: "px",
  },
  {
    name: "--zoom-animation-duration",
    label: "Duration",
    min: 100,
    max: 1200,
    step: 50,
    value: 300,
    unit: "ms",
  },
];
---

<div class="playground wide">
  <form class="controls" data-playground aria-label="Zoom playground">
    <fieldset class="colors">
      <legend>Colors</legend>
      {colors.map(({ name, label, value }) => (
        <label class="color">
          <input type="color" name={name} value={value} />
          <span>
            {label}
            <code>{name}</code>
          </span>
        </label>
      ))}
    </fieldset>

    <fieldset>
      <legend>Layout and motion</legend>
      {ranges.map(({ name, label, min, max, step, value, unit }) => (
        <label class="range">
          <span>
            {label} <code>{name}</code>
          </span>
          <input
            type="range"
            name={name}
            min={min}
            max={max}
            step={step}
            value={value}
            data-unit={unit}
          />
          <output
            data-for={name}
            data-default={`${value}${unit}`}
          >{`${value}${unit}`}</output>
        </label>
      ))}
    </fieldset>

    <fieldset>
      <legend>Caption props</legend>
      <div class="choices">
        <label>
          <input type="radio" name="captionPosition" value="bottom" checked />{" "}
          Bottom
        </label>
        <label>
          <input type="radio" name="captionPosition" value="top" /> Top
        </label>
        <label>
          <input type="checkbox" name="showCaption" checked /> Show caption
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Navigation props</legend>
      <div class="choices">
        <label>
          <input type="radio" name="navigationLayout" value="bar" checked /> Bar
        </label>
        <label>
          <input type="radio" name="navigationLayout" value="sides" /> Sides
        </label>
        <label>
          <input type="checkbox" name="showCounter" checked /> Show counter
        </label>
      </div>
    </fieldset>

    <button type="reset">Reset</button>
  </form>

  <div class="preview">
    <!-- The variables go on this element, around the gallery: only this gallery changes -->
    <div data-playground-scope>
      <ImageZoom>
        <div class="preview-images">
          {images.map((name) => (
            <Photo
              name={name}
              width={322}
              height={242}
              sizes="(min-width: 48rem) 322px, 42vw"
            />
          ))}
        </div>
      </ImageZoom>
    </div>
    <!-- Focusable, as Astro's <Code> blocks: a long line scrolls sideways, also with the keyboard -->
    <pre class="snippet" tabindex="0"><code data-snippet>/* Change a value to see the code */</code></pre>
  </div>
</div>

<script>
  // Mirrors each changed control into a CSS variable on the element around the gallery, and the
  // caption controls into the props (data attributes) of its <astro-image-zoom>
  const form = document.querySelector<HTMLFormElement>("[data-playground]");
  const scope = document.querySelector<HTMLElement>("[data-playground-scope]");
  const zoom = scope?.querySelector<HTMLElement>("astro-image-zoom");
  const snippet = document.querySelector<HTMLElement>("[data-snippet]");
  const changed = new Map<string, string>();

  const render = () => {
    if (!snippet || !zoom) return;
    const props = [
      zoom.dataset.captionPosition === "top" ? ' captionPosition="top"' : "",
      zoom.dataset.showCaption === "false" ? " showCaption={false}" : "",
      zoom.dataset.navigationLayout === "sides"
        ? ' navigationLayout="sides"'
        : "",
      zoom.dataset.showCounter === "false" ? " showCounter={false}" : "",
    ].join("");
    const css = changed.size
      ? `.gallery {\n${[...changed].map(([name, value]) => `  ${name}: ${value};`).join("\n")}\n}`
      : "";
    // The variables go on the component through a class, so the code works as it is
    const markup =
      css || props ? `<ImageZoom${css ? ' class="gallery"' : ""}${props}>` : "";
    snippet.textContent =
      [css, markup].filter(Boolean).join("\n\n") ||
      "/* Change a value to see the code */";
  };

  form?.addEventListener("input", (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement) || !scope || !zoom) return;

    if (input.name === "captionPosition") {
      zoom.dataset.captionPosition = input.value;
    } else if (input.name === "showCaption") {
      zoom.dataset.showCaption = String(input.checked);
    } else if (input.name === "navigationLayout") {
      zoom.dataset.navigationLayout = input.value;
    } else if (input.name === "showCounter") {
      zoom.dataset.showCounter = String(input.checked);
    } else {
      const value = input.value + (input.dataset.unit ?? "");
      changed.set(input.name, value);
      scope.style.setProperty(input.name, value);
      const output = form.querySelector<HTMLOutputElement>(
        `output[data-for="${input.name}"]`,
      );
      if (output) output.value = value;
    }
    render();
  });

  form?.addEventListener("reset", () => {
    for (const name of changed.keys()) scope?.style.removeProperty(name);
    changed.clear();
    if (zoom) {
      zoom.dataset.captionPosition = "bottom";
      zoom.dataset.showCaption = "true";
      zoom.dataset.navigationLayout = "bar";
      zoom.dataset.showCounter = "true";
    }
    for (const output of form.querySelectorAll<HTMLOutputElement>("output")) {
      output.value = output.dataset.default ?? "";
    }
    render();
  });
</script>

<style>
  @layer components {
    .playground {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
      gap: 1.5rem 2.5rem;
      padding: clamp(1.25rem, 3vw, 2rem);
      font-size: 0.875rem;
      background: var(--color-surface);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
    }

    .controls {
      display: grid;
      gap: 1.25rem;
      align-content: start;
    }

    fieldset {
      display: grid;
      gap: 0.5rem;
      min-inline-size: 0;
      margin: 0;
      padding: 0;
      border: 0;
    }

    legend {
      margin-block-end: 0.5rem;
      padding: 0;
      font-weight: 700;
      font-variation-settings: var(--heading-width);
    }

    /* The colors fill two columns when there is room */
    .colors {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
      gap: 0.75rem 1rem;
    }

    label {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem 0.75rem;
    }

    label code {
      display: block;
      inline-size: fit-content;
      margin-block-start: 0.125rem;
      overflow-wrap: anywhere;
    }

    /* The swatch and its name side by side, even in a narrow column */
    .color {
      flex-wrap: nowrap;
    }

    .color span {
      flex: 1 1 0;
      min-inline-size: 0;
    }

    input[type="color"] {
      flex: none;
      inline-size: 2.75rem;
      block-size: 2rem;
      padding: 0.125rem;
      background: var(--color-bg);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
      cursor: pointer;
    }

    .range span {
      flex-basis: 100%;
    }

    input[type="range"] {
      flex: 1 1 8rem;
      min-inline-size: 0;
    }

    output {
      min-inline-size: 4.5ch;
      font-variant-numeric: tabular-nums;
    }

    button {
      justify-self: start;
      padding: 0.5rem 1rem;
      color: var(--color-text);
      background: var(--color-bg);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
      cursor: pointer;

      &:hover {
        border-color: var(--color-text-muted);
      }
    }

    /* The photos and the code stay in view while the controls scroll */
    .preview {
      display: grid;
      gap: 1rem;
      align-content: start;
      align-self: start;
      min-inline-size: 0;

      @media (width >= 48rem) {
        position: sticky;
        top: var(--sticky-top);
      }
    }

    .preview-images {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .choices {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;

      label {
        gap: 0.5rem;
      }
    }

    .snippet {
      margin: 0;
      overflow-x: auto;
      color: #e6edf3;
      background: #0d1117;
    }
  }
</style>
