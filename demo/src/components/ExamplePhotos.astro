---
import ImageZoom from "astro-image-zoom/ImageZoom.astro";
import type { ComponentProps } from "astro/types";
import Photo from "@components/Photo.astro";
import type { PhotoName } from "@data/photos";

type ZoomProps = Omit<ComponentProps<typeof ImageZoom>, "class">;

interface Props {
  names: Exclude<PhotoName, "blueMarble">[];
  /**
   * Props of the <ImageZoom> the example is about. An array makes one gallery per photo, each
   * with its own props, to compare them side by side
   */
  zoom?: ZoomProps | ZoomProps[];
}

const { names, zoom = {} } = Astro.props;
// Each file is cut to the shape of its frame on a wide screen, and sizes follow the frame: one photo
// takes it all, two split it, three put a big one beside two small ones. Measured from 64rem (docs
// with the index), from 40rem (two examples per row) and on phones
const frames = {
  1: [
    {
      width: 450,
      height: 300,
      sizes:
        "(min-width: 64rem) min(33vw, 450px), (min-width: 40rem) 45vw, 93vw",
    },
  ],
  2: [
    {
      width: 222,
      height: 300,
      sizes:
        "(min-width: 64rem) min(17vw, 222px), (min-width: 40rem) 22vw, 46vw",
    },
  ],
  3: [
    {
      width: 300,
      height: 300,
      sizes:
        "(min-width: 64rem) min(22vw, 300px), (min-width: 40rem) 29vw, 61vw",
    },
    {
      width: 150,
      height: 150,
      sizes:
        "(min-width: 64rem) min(11vw, 150px), (min-width: 40rem) 15vw, 31vw",
    },
  ],
};
const shape = frames[Math.min(names.length, 3) as 1 | 2 | 3];
const photo = (name: Props["names"][number], index: number) => ({
  name,
  ...(shape[index] ?? shape[shape.length - 1]),
  caption: false,
  fill: true,
});
---

{/* One photo takes the whole frame, two share it; with three, the first is bigger and the others stack beside it */}
<div class="photos photo-grid" data-count={Math.min(names.length, 3)}>
  {Array.isArray(zoom) ? (
    names.map((name, index) => (
      <ImageZoom {...zoom[index]}>
        <Photo {...photo(name, index)} />
      </ImageZoom>
    ))
  ) : (
    <ImageZoom {...zoom}>
      {names.map((name, index) => (
        <Photo {...photo(name, index)} />
      ))}
    </ImageZoom>
  )}
</div>

<style>
  @layer components {
    .photos {
      display: grid;
      grid-auto-rows: 1fr;
      gap: 0.375rem;
      aspect-ratio: 3 / 2;

      &[data-count="2"] {
        grid-template-columns: 1fr 1fr;
      }

      &[data-count="3"] {
        grid-template-columns: 2fr 1fr;

        /* <astro-image-zoom> is display: contents: the photos are the grid items */
        > :global(astro-image-zoom > :first-child) {
          grid-row: span 2;
        }
      }
    }
  }
</style>
