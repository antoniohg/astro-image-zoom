---
interface Entry {
  id: string;
  title: string;
}

interface Props {
  /** Chapters of the page, each with its sections */
  entries: (Entry & { children?: Entry[] })[];
}

const { entries } = Astro.props;
---

<!-- Folded on narrow screens, where it would fill the first screen; always open from 64rem -->
<nav class="toc" aria-label="On this page" data-toc>
  <details>
    <summary>On this page</summary>
    <ol>
      {entries.map(({ id, title, children = [] }) => (
        <li>
          <a href={`#${id}`}>{title}</a>
          {children.length > 0 && (
            <ol>
              {children.map((child) => (
                <li>
                  <a href={`#${child.id}`}>{child.title}</a>
                </li>
              ))}
            </ol>
          )}
        </li>
      ))}
    </ol>
  </details>
</nav>

<script>
  // Marks the entry of the index for the section being read: the last heading that has passed
  // the top third of the screen
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a"),
  ];
  const entries = links.flatMap((link) => {
    const heading = document.getElementById(
      decodeURIComponent(link.hash.slice(1)),
    );
    return heading ? [{ link, heading }] : [];
  });
  let frame = 0;

  const update = () => {
    frame = 0;
    const line = window.innerHeight / 3;
    const current =
      entries.findLast(
        ({ heading }) => heading.getBoundingClientRect().top <= line,
      ) ?? entries[0];
    for (const { link } of entries) {
      if (link === current?.link) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    }
  };

  const schedule = () => {
    frame ||= requestAnimationFrame(update);
  };

  // On narrow screens, a link folds the index again, so the section shows under it
  const details =
    document.querySelector<HTMLDetailsElement>("[data-toc] details");
  const wide = matchMedia("(width >= 64rem)");
  for (const { link } of entries) {
    link.addEventListener("click", () => {
      if (details && !wide.matches) details.open = false;
    });
  }

  addEventListener("scroll", schedule, { passive: true });
  addEventListener("resize", schedule, { passive: true });
  update();
</script>

<style>
  @layer components {
    .toc {
      font-size: 0.875rem;

      @media (width >= 64rem) {
        position: sticky;
        top: var(--sticky-top);
        align-self: start;
      }

      summary {
        inline-size: fit-content;
        padding-block: 0.375rem;
        font-weight: 600;
        cursor: pointer;
      }

      details[open] > summary {
        margin-block-end: 0.75rem;
      }

      /*
       * Always open from 64rem: no summary, and the content shown even when closed. Browsers
       * without ::details-content keep the summary, so the index can still be unfolded
       */
      @supports selector(::details-content) {
        @media (width >= 64rem) {
          summary {
            display: none;
          }

          details::details-content {
            content-visibility: visible;
            block-size: auto;
          }
        }
      }

      ol {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      details > ol {
        gap: 0.75rem;
      }

      ol ol {
        margin-block-start: 0.25rem;
      }

      a {
        display: block;
        padding-block: 0.1875rem;
        padding-inline-start: 0.875rem;
        color: var(--color-text-muted);
        text-decoration: none;
        border-inline-start: 2px solid var(--color-rule);

        &:hover {
          color: var(--color-text);
        }

        &[aria-current] {
          color: var(--color-text);
          border-inline-start-color: var(--color-accent);
        }
      }

      ol ol a {
        padding-inline-start: 1.625rem;
      }

      /* Chapters in bold; the chapter being read in the text color */
      details > ol > li > a {
        font-weight: 600;
      }

      details > ol > li:has([aria-current]) > a {
        color: var(--color-text);
      }
    }
  }
</style>
