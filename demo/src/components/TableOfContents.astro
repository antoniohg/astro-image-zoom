---
interface Entry {
  id: string;
  title: string;
}

interface Props {
  /** Chapters of the page, each with its sections */
  entries: (Entry & { children?: Entry[] })[];
}

const { entries } = Astro.props;
---

{/* Folded on narrow screens, where it would fill the first screen; always open from 64rem */}
<nav class="toc" aria-label="On this page" data-toc>
  <details>
    <summary>On this page</summary>
    <ol role="list">
      {entries.map(({ id, title, children = [] }) => (
        <li>
          <a href={`#${id}`}>{title}</a>
          {children.length > 0 && (
            <ol role="list">
              {children.map((child) => (
                <li>
                  <a href={`#${child.id}`}>{child.title}</a>
                </li>
              ))}
            </ol>
          )}
        </li>
      ))}
    </ol>
  </details>
</nav>

<script>
  // Marks the entry of the index for the section being read: the last heading that has passed
  // the top third of the screen
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a"),
  ];
  const entries = links.flatMap((link) => {
    const heading = document.getElementById(
      decodeURIComponent(link.hash.slice(1)),
    );
    return heading ? [{ link, heading }] : [];
  });
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;
  let shown: HTMLAnchorElement | undefined;

  // From 64rem the index scrolls on its own when it is taller than the screen: when the entry
  // being read changes, scroll the index, not the page (as scrollIntoView would), to show it with
  // some room around. Only then, so a reader scrolling the index by hand keeps their place
  const reveal = (link: HTMLAnchorElement) => {
    if (!toc || toc.scrollHeight <= toc.clientHeight) return;
    const room = 48;
    const box = toc.getBoundingClientRect();
    const { top, bottom } = link.getBoundingClientRect();
    const delta =
      top < box.top + room
        ? top - box.top - room
        : bottom > box.bottom - room
          ? bottom - box.bottom + room
          : 0;
    if (delta)
      toc.scrollBy({
        top: delta,
        behavior: reducedMotion.matches ? "instant" : "smooth",
      });
  };

  const update = () => {
    frame = 0;
    const line = window.innerHeight / 3;
    const current =
      entries.findLast(
        ({ heading }) => heading.getBoundingClientRect().top <= line,
      ) ?? entries[0];
    for (const { link } of entries) {
      if (link === current?.link) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    }
    if (current && current.link !== shown) {
      shown = current.link;
      reveal(current.link);
    }
  };

  const schedule = () => {
    frame ||= requestAnimationFrame(update);
  };

  // Open from 64rem, also in browsers without ::details-content, and folded again below
  const details =
    document.querySelector<HTMLDetailsElement>("[data-toc] details");
  const wide = matchMedia("(width >= 64rem)");
  const sync = () => {
    if (details) details.open = wide.matches;
  };
  wide.addEventListener("change", sync);
  sync();

  // On narrow screens, a link folds the index again, so the section shows under it
  for (const { link } of entries) {
    link.addEventListener("click", () => {
      if (details && !wide.matches) details.open = false;
    });
  }

  addEventListener("scroll", schedule, { passive: true });
  addEventListener("resize", schedule, { passive: true });
  update();
</script>

<style>
  @layer components {
    .toc {
      font-size: 0.875rem;

      /* Taller than the screen, it scrolls on its own: sticky, its end would never show */
      @media (width >= 64rem) {
        position: sticky;
        top: var(--sticky-top);
        align-self: start;
        max-block-size: calc(100dvh - var(--sticky-top));
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        /* Room for the focus ring, which the scroll box would clip; the margin keeps the layout */
        --ring-room: calc(var(--focus-offset) + 2px);
        margin: calc(-1 * var(--ring-room));
        padding: var(--ring-room);
      }

      summary {
        inline-size: fit-content;
        padding-block: 0.375rem;
        font-weight: 600;
        cursor: pointer;
      }

      details[open] > summary {
        margin-block-end: 0.75rem;
      }

      /*
       * Always open from 64rem: no summary, and the content shown even when closed (before the
       * script opens it, or without JavaScript). Browsers without ::details-content keep the
       * summary; the script opens the index for them
       */
      @supports selector(::details-content) {
        @media (width >= 64rem) {
          summary {
            display: none;
          }

          details::details-content {
            content-visibility: visible;
            block-size: auto;
          }
        }
      }

      details > ol {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      ol ol {
        margin-block-start: 0.25rem;
      }

      a {
        display: block;
        padding-block: 0.1875rem;
        padding-inline-start: 0.875rem;
        color: var(--color-text-muted);
        text-decoration: none;
        border-inline-start: 2px solid var(--color-rule);

        &:hover {
          color: var(--color-text);
        }

        &[aria-current] {
          color: var(--color-text);
          border-inline-start-color: var(--color-accent);
        }
      }

      ol ol a {
        padding-inline-start: 1.625rem;
      }

      /* Chapters in bold; the chapter being read in the text color */
      details > ol > li > a {
        font-weight: 600;
      }

      details > ol > li:has([aria-current]) > a {
        color: var(--color-text);
      }
    }
  }
</style>
