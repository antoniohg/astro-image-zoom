---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: "astro" | "css" | "sh";
  /** Show the code directly instead of behind a "Show code" disclosure */
  open?: boolean;
}

const { code, lang = "astro", open = false } = Astro.props;
---

{open ? (
  <Code code={code} lang={lang} theme="github-dark-default" />
) : (
  <details class="code-sample">
    <summary>Show code</summary>
    <Code code={code} lang={lang} theme="github-dark-default" />
  </details>
)}

<style>
  @layer components {
    .code-sample {
      font-family: var(--font-sans);
      font-size: 0.875rem;

      summary {
        inline-size: fit-content;
        color: var(--color-text-muted);
        cursor: pointer;

        &:hover {
          color: var(--color-text);
        }
      }

      &[open] summary {
        margin-block-end: 0.75rem;
      }
    }
  }
</style>
