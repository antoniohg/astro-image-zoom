---
// First import, and the layout first in every page: Astro orders the stylesheets by the position
// of their imports, so global.css, with the order of the cascade layers, comes before any other
import "../styles/global.css";
import { Font } from "astro:assets";
import GlobeIcon from "../assets/icons/globe-hemisphere-west.svg";

interface Props {
  title: string;
  description: string;
  /** The page of the main navigation this one is, marked with aria-current; none for the 404 */
  current?: "home" | "docs";
  /** Keeps the page out of search engines, as the 404 */
  noindex?: boolean;
}

const { title, description, current, noindex = false } = Astro.props;
const repository = "https://github.com/antoniohg/astro-image-zoom";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// Absolute URLs for search engines and link previews; Astro.site comes from `site` in the config
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview image when a page is shared: the same card as the social preview of the repository
const shareImageUrl = new URL(`${base}og.png`, Astro.site);
const shareImageAlt =
  "astro-image-zoom, Medium-style image zoom for Astro: an image grows from a page into an overlay";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="astro-image-zoom" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-archivo-expanded" preload />
    <Font cssVariable="--font-plex-mono" preload />
  </head>
  <body>
    <header>
      <div class="header-content">
        <a class="logo" href={base}>
          astro-image-<span class="logo-zoom">zoom</span>
        </a>
        <nav class="header-nav" aria-label="Main">
          <ul role="list">
            <li>
              <a
                href={base}
                aria-current={current === "home" ? "page" : undefined}
              >
                Overview
              </a>
            </li>
            <li>
              <a
                href={`${base}docs/`}
                aria-current={current === "docs" ? "page" : undefined}
              >
                Docs
              </a>
            </li>
            <li>
              <a href={repository}>GitHub</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p class="signature">
        <GlobeIcon class="globe" width={16} height={16} aria-hidden="true" />
        Made on planet Earth by{" "}
        <a href="https://antoniohg.com" rel="author">
          antoniohg
        </a>
      </p>
      <p>
        MIT licensed · <a href={repository}>Source on GitHub</a> · Photos from
        the <a href="https://images.nasa.gov">NASA Image and Video Library</a>,
        credits in{" "}
        <a href={`${repository}/blob/main/demo/PHOTOS.md`}>PHOTOS.md</a>
      </p>
    </footer>
  </body>
</html>
