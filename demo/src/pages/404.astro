---
import Layout from "@layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout
  title="Page not found · astro-image-zoom"
  description="This page of astro-image-zoom doesn't exist, or it has moved."
  noindex
>
  <article class="not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="lead">
      This page lifted off and never landed: it doesn't exist, or it has moved.
      The overview and the docs are still where they were.
    </p>
    <div class="actions">
      <a class="button" href={`${base}docs/`}>
        Read the docs
      </a>
      <a class="button secondary" href={base}>
        Go to the overview
      </a>
    </div>
  </article>
</Layout>

<style>
  @layer components {
    .not-found {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: 1.25rem;
      max-inline-size: calc(var(--width-text) + 2 * var(--gutter));
      margin-inline: auto;
      padding-inline: var(--gutter);
      padding-block: clamp(2rem, 8vw, 6rem);
    }

    /* The status code, in the accent color made for text */
    .code {
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-accent-text);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-block-start: 0.5rem;
    }
  }
</style>
