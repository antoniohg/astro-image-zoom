---
import Layout from "@layouts/Layout.astro";
import { Picture, getImage } from "astro:assets";
import ImageZoom from "astro-image-zoom/ImageZoom.astro";
import Section from "@components/Section.astro";
import CodeSample from "@components/CodeSample.astro";
import InstallCommand from "@components/InstallCommand.astro";
import CssPlayground from "@components/CssPlayground.astro";
import EventsConsole from "@components/EventsConsole.astro";
import Example from "@components/Example.astro";
import ExamplePhotos from "@components/ExamplePhotos.astro";
import OverlaySketch from "@components/OverlaySketch.astro";
import Reference from "@components/Reference.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Photo from "@components/Photo.astro";
import { photos, type PhotoName } from "@data/photos";
import {
  attributes,
  colorVariables,
  eventDetail,
  events,
  labels,
  layoutVariables,
  otherVariables,
  parts,
  props,
} from "@data/reference";
import type { ComponentProps } from "astro/types";
import SelectionBackgroundIcon from "../assets/icons/selection-background.svg";
import MagnifyingGlassMinusIcon from "../assets/icons/magnifying-glass-minus.svg";
import MouseScrollIcon from "../assets/icons/mouse-scroll.svg";
import GaugeIcon from "../assets/icons/gauge.svg";

type LocalPhoto = Exclude<PhotoName, "blueMarble">;

type ExampleData = Omit<ComponentProps<typeof Example>, "level"> & {
  names: LocalPhoto[];
  zoom?: ComponentProps<typeof ExamplePhotos>["zoom"];
};

// The code of an example made with CSS variables: the rule that sets them
const cssRule = (selector: string, vars: Record<string, string>) =>
  `${selector} {\n${Object.entries(vars)
    .map(([name, value]) => `  ${name}: ${value};`)
    .join("\n")}\n}`;

// Each option gets a small live demo with its own photos
const options: ExampleData[] = [
  {
    title: "No arrows or counter",
    description: "Keys and swipes still move through the gallery.",
    code: "<ImageZoom showNavigation={false}>",
    sketch: { nav: "none" },
    names: ["orionEarthMoon", "orionArray", "orionMoon"],
    zoom: { showNavigation: false },
  },
  {
    title: "Stays open on a backdrop click",
    description:
      "A click on the backdrop does nothing; the close button and Escape still work.",
    code: "<ImageZoom closeOnBackdrop={false}>",
    icon: SelectionBackgroundIcon,
    names: ["edWhite"],
    zoom: { closeOnBackdrop: false },
  },
  {
    title: "Stays open on an image click",
    description: "A click on the zoomed image does nothing.",
    code: "<ImageZoom closeOnImage={false}>",
    icon: MagnifyingGlassMinusIcon,
    names: ["mccandless"],
    zoom: { closeOnImage: false },
  },
  {
    title: "Stays open while scrolling",
    description:
      "A wheel, a touchpad scroll or a vertical swipe doesn't close it.",
    code: "<ImageZoom closeOnScroll={false}>",
    icon: MouseScrollIcon,
    names: ["issArrays"],
    zoom: { closeOnScroll: false },
  },
];

// Props for the navigation and the caption, CSS variables around the gallery for the rest
const navigation: ExampleData[] = [
  {
    title: "Arrows at the sides",
    description:
      "The arrows move to the screen edges; the counter stays at the bottom.",
    code: `<ImageZoom navigationLayout="sides">`,
    sketch: { nav: "sides", highlight: ["nav"] },
    names: ["gordiiFossae", "arabiaTerra", "galeDaybreak"],
    zoom: { navigationLayout: "sides" },
  },
  {
    title: "No counter",
    description:
      "Only the arrows in the bar, without the position in the gallery.",
    code: "<ImageZoom showCounter={false}>",
    sketch: { counter: false, highlight: ["nav"] },
    names: ["seoulNight", "beanLadder"],
    zoom: { showCounter: false },
  },
];

const captions: ExampleData[] = [
  {
    title: "Caption at the top",
    description: "Useful when the bottom of the photos holds the subject.",
    code: `<ImageZoom captionPosition="top">`,
    sketch: { caption: "top", highlight: ["caption"] },
    names: ["milton"],
    zoom: { captionPosition: "top" },
  },
  {
    title: "No caption",
    description:
      "For photos that speak for themselves. The image keeps its alt text.",
    code: "<ImageZoom showCaption={false}>",
    sketch: { caption: "none" },
    names: ["bootprint"],
    zoom: { showCaption: false },
  },
];

const framed = { "--zoom-padding": "6vmin", "--zoom-image-radius": "16px" };
const customControls = {
  "--zoom-button-size": "38px",
  "--zoom-button-radius": "2px",
  "--zoom-caption-radius": "0",
  "--zoom-controls-offset": "0.75rem",
  "--zoom-caption-bg": "#ff7a66",
  "--zoom-caption-color": "#131722",
};

const spacing: ExampleData[] = [
  {
    title: "Padding and corners",
    description: "Room around the zoomed image, and rounded corners.",
    code: cssRule(".framed", framed),
    lang: "css",
    vars: framed,
    sketch: { padded: true, highlight: ["image"] },
    names: ["auroraAustralis"],
  },
  {
    title: "Buttons and caption",
    description:
      "Square buttons, a flat caption in the accent color, everything closer to the edges.",
    code: cssRule(".custom-controls", customControls),
    lang: "css",
    vars: customControls,
    sketch: { square: true, highlight: ["close", "nav", "caption"] },
    names: ["auroraRed", "starsSetting"],
  },
];

// The <Picture> example builds its own full-size version
const sunflowerFull = await getImage({
  src: photos.sunflower.src,
  width: photos.sunflower.src.width,
  format: "avif",
});
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// Public domain image from NASA, loaded from its own server
const remote = {
  src: "https://images-assets.nasa.gov/image/PIA15985/PIA15985~large.jpg",
  alt: "Pillar of gas and dust in the Carina Nebula, photographed by Hubble",
  caption: "Mystic Mountain in the Carina Nebula — Hubble",
};

const toc: ComponentProps<typeof TableOfContents>["entries"] = [
  {
    id: "usage",
    title: "Usage",
    children: [
      { id: "sources", title: "Image sources" },
      { id: "links", title: "Links" },
      { id: "nested", title: "Nested markup" },
      { id: "ignore", title: "Leaving images out" },
      { id: "thumbnails", title: "Your thumbnails" },
    ],
  },
  { id: "behavior", title: "Behavior" },
  {
    id: "layout",
    title: "Layout",
    children: [
      { id: "navigation", title: "Navigation" },
      { id: "caption", title: "Caption" },
      { id: "layout-variables", title: "Spacing and controls" },
      { id: "responsive", title: "Screen sizes" },
    ],
  },
  {
    id: "theming",
    title: "Theming",
    children: [
      { id: "playground", title: "Playground" },
      { id: "theme-prop", title: "The theme prop" },
      { id: "css-variables", title: "CSS variables" },
      { id: "parts", title: "Parts" },
    ],
  },
  { id: "labels", title: "Labels" },
  { id: "events", title: "Events" },
  { id: "javascript-api", title: "JavaScript API" },
  { id: "reference", title: "Reference" },
];
---

<Layout
  title="Docs · astro-image-zoom"
  description="Behavior, layout, theming, labels, events and the JavaScript API of astro-image-zoom, with live examples."
  current="docs"
>
  <div class="docs">
    <header class="intro">
      <h1>Docs</h1>
      <p class="lead">
        Everything <code>{`<ImageZoom>`}</code> can do, with live examples.
        Every image on this page opens.
      </p>
    </header>

    <TableOfContents entries={toc} />

    <article class="flow content">
      <Section title="Usage" id="usage">
        <InstallCommand id="docs" />
        <p>
          Put <code>{`<ImageZoom>`}</code> around any markup with images. It
          wraps each one in a link to the file the zoom opens, so without
          JavaScript the link still opens the image.
        </p>
        <CodeSample
          open
          code={`---
import ImageZoom from 'astro-image-zoom/ImageZoom.astro';
---
<ImageZoom>
  <img src="/earthrise.jpg" alt="Earth rising above the Moon" />
</ImageZoom>`}
        />
        <div class="note">
          <p>
            <strong>A larger file for the zoom.</strong> The zoom never shows an
            image bigger than its file, and without{" "}
            <code>data-image-zoom-src</code> it opens the image's own{" "}
            <code>src</code>. When the page shows a smaller version, such as a
            thumbnail in an <code>{`<img>`}</code> or the 800&nbsp;px file
            Astro's <code>{`<Image width={800}>`}</code> generates, point{" "}
            <code>data-image-zoom-src</code> at the full-size one.
          </p>
          <CodeSample
            open
            code={`---
import ImageZoom from 'astro-image-zoom/ImageZoom.astro';
import { Image, getImage } from 'astro:assets';
import photo from '../assets/earthrise.jpg';

// Full-size version for the zoom
const fullSize = await getImage({ src: photo, width: photo.width });
---
<ImageZoom>
  <Image src={photo} alt="Earth rising above the Moon" width={800}
    data-image-zoom-src={fullSize.src} data-image-zoom-caption="Earthrise — Apollo 8, 1968" />
</ImageZoom>`}
          />
        </div>
        <Section title="Image sources" id="sources" level={3}>
          <p>
            Astro's <code>{`<Image>`}</code> and <code>{`<Picture>`}</code>, a
            plain <code>{`<img>`}</code>
            from <code>public/</code>, or an image on another server.
          </p>
          <p>
            Prefer <code>{`<Image>`}</code> or <code>{`<Picture>`}</code>: Astro
            resizes and compresses them, so the page loads light images; with{" "}
            <code>data-image-zoom-src</code>, the zoom fetches the full size
            only when it opens. Plain
            <code>{`<img>`}</code> tags work just as well, but they ship
            whatever file you give them.
          </p>
          <ImageZoom>
            <div class="sources">
              <div class="source">
                <Photo
                  name="pillars"
                  width={300}
                  height={225}
                  sizes="(min-width: 32rem) 300px, 94vw"
                  caption={false}
                />
                <p class="label">
                  <code>{`<Image>`}</code> · Pillars of Creation
                </p>
              </div>
              <div class="source">
                <Picture
                  src={photos.sunflower.src}
                  alt={photos.sunflower.alt}
                  width={300}
                  height={225}
                  widths={[300, 600]}
                  sizes="(min-width: 32rem) 300px, 94vw"
                  formats={["avif", "webp"]}
                  data-image-zoom-src={sunflowerFull.src}
                  data-image-zoom-caption={`${photos.sunflower.caption} — ${photos.sunflower.mission}`}
                />
                <p class="label">
                  <code>{`<Picture>`}</code> · Sunflower galaxy
                </p>
              </div>
              <div class="source">
                {/* A small copy for the page, the full file for the zoom */}
                <img
                  src={`${base}images/as17-148-22727-640.jpg`}
                  alt={photos.blueMarble.alt}
                  width="640"
                  height="640"
                  data-image-zoom-src={`${base}images/as17-148-22727.jpg`}
                  loading="lazy"
                  decoding="async"
                  data-image-zoom-caption={`${photos.blueMarble.caption} — ${photos.blueMarble.mission}, ${photos.blueMarble.year}`}
                />
                <p class="label">
                  <code>{`<img>`}</code> from <code>public/</code> · The Blue
                  Marble
                </p>
              </div>
              <div class="source">
                <img
                  src={remote.src}
                  alt={remote.alt}
                  width="1920"
                  height="1767"
                  loading="lazy"
                  decoding="async"
                  data-image-zoom-caption={remote.caption}
                />
                <p class="label">
                  Remote <code>{`<img>`}</code> · Mystic Mountain
                </p>
              </div>
            </div>
          </ImageZoom>
          <CodeSample
            code={`<ImageZoom>
  <Image src={photo} alt="…" width={640} data-image-zoom-src={fullSize.src} />
  <Picture src={photo} alt="…" widths={[640]} formats={['avif', 'webp']} data-image-zoom-src={fullSize.src} />
  <img src="/images/blue-marble-small.jpg" alt="…" data-image-zoom-src="/images/blue-marble.jpg" />
  <img src="https://images-assets.nasa.gov/image/PIA15985/PIA15985~large.jpg" alt="…" />
</ImageZoom>`}
          />
        </Section>

        <Section title="Links" id="links" level={3}>
          <p>
            An image inside a link with <code>data-image-zoom</code> opens the
            link's <code>href</code>. Put the caption on the link, in{" "}
            <code>data-image-zoom-caption</code> or <code>title</code>: the
            image inside only gives its alt text. Images inside any other link,
            or inside a button, are left alone, so cards and logos keep working
            as links.
          </p>
          <CodeSample
            open
            code={`<ImageZoom>
  <a href="/full-size-1.jpg" data-image-zoom data-image-zoom-caption="Harbor at dawn">
    <img src="/thumbnail-1.jpg" alt="Harbor at dawn" />
  </a>
</ImageZoom>`}
          />
        </Section>

        <Section title="Nested markup" id="nested" level={3}>
          <p>
            Images at any depth inside the component zoom too, like those of
            this card.
          </p>
          <ImageZoom>
            <article class="card">
              <Photo
                name="apollo11Rollout"
                width={928}
                height={433}
                sizes="(min-width: 64rem) min(70vw, 928px), 94vw"
                caption={false}
              />
              <div class="card-body">
                <p class="label">Photo essay · 4 images</p>
                <h4>Leaving the pad</h4>
                <p>
                  From Mercury capsules to the Space Shuttle: how the early
                  crews got to space and back.
                </p>
                <div class="card-thumbs">
                  {(
                    ["glenn", "shepardRescue", "challengerLaunch"] as const
                  ).map((name) => (
                    <Photo
                      name={name}
                      width={290}
                      height={218}
                      sizes="(min-width: 64rem) min(23vw, 290px), 29vw"
                      caption={false}
                    />
                  ))}
                </div>
              </div>
            </article>
          </ImageZoom>
        </Section>

        <Section title="Leaving images out" id="ignore" level={3}>
          <p>
            Logos, avatars and decorative images inside a wrapped article
            shouldn't zoom. List them in the <code>ignore</code> prop: an
            ignored image isn't wrapped in a link and doesn't count in the
            gallery. Each selector is checked against the image and every
            element around it, so <code>.author</code> leaves out every image in
            the aside.
          </p>
          <CodeSample
            code={`<ImageZoom ignore=".logo, .author, [alt='']">
  <img src="/photo.jpg" alt="Harbor at dawn" />
  <img class="logo" src="/logo.svg" alt="Harbor Co." />
  <img src="/divider.svg" alt="" />
  <aside class="author"><img src="/avatar.jpg" alt="The author" /></aside>
  <!-- One image, without the prop -->
  <img src="/signature.svg" alt="Signature" data-image-zoom-ignore />
</ImageZoom>`}
          />
          <p>
            The images are wrapped on the server, without a DOM, so
            <code>ignore</code> takes simple selectors only: a tag name,
            <code>.classes</code>, <code>#ids</code> and
            <code>[attributes]</code>, combined as in
            <code>img.logo[alt='']</code>. Spaces inside a selector, combinators
            and pseudo-classes fail the build with an error that names the
            selector.
          </p>
        </Section>

        <Section title="Your thumbnails" id="thumbnails" level={3}>
          <p>
            The component doesn't style the images on your page, not even their
            focus ring. Each one gets an inline
            <code>{`<a data-image-zoom-generated>`}</code> with your link
            styles, and if your images are <code>display: block</code>, the
            outline of that link doesn't wrap them. Draw your focus ring on the
            image instead, as this page does, and add a zoom cursor if you like.
          </p>
          <CodeSample
            open
            lang="css"
            code={`a[data-image-zoom-generated]:focus-visible {
  outline: none;
}

a[data-image-zoom-generated]:focus-visible img {
  outline: 2px solid green; /* your focus ring */
  outline-offset: 3px; /* negative if a parent with overflow: hidden clips it */
}

a[data-image-zoom-generated] img {
  cursor: zoom-in;
}`}
          />
        </Section>
      </Section>

      <Section title="Behavior" id="behavior">
        <p>
          Props change how the zoom moves, closes and animates. Open each
          example to try it.
        </p>
        <ul class="examples" role="list">
          {options.map(({ names, zoom, ...example }) => (
            <Example {...example} level={3}>
              <ExamplePhotos names={names} zoom={zoom} />
            </Example>
          ))}
          <Example
            title="Faster or slower"
            description="The length of the zoom in milliseconds: 150 on the left, 800 on the right."
            code={`<ImageZoom animationDuration={150}>
<ImageZoom animationDuration={800}>`}
            icon={GaugeIcon}
            level={3}
          >
            <ExamplePhotos
              names={["saturnVLaunch", "andromeda"]}
              zoom={[{ animationDuration: 150 }, { animationDuration: 800 }]}
            />
          </Example>
        </ul>
      </Section>

      <Section title="Layout" id="layout">
        <p>
          Props choose where the navigation and the caption go. Spacing, corners
          and the size and shape of the controls are CSS variables: set them on
          any element around an
          <code>{`<ImageZoom>`}</code> to change that gallery only, or on{" "}
          <code>:root</code> for the whole site.
        </p>
        <figure class="default-layout">
          <OverlaySketch />
          <figcaption>
            <p>
              <strong>The default layout</strong>
            </p>
            <ul>
              <li>The close button at the top right</li>
              <li>The caption at the bottom, over the image</li>
              <li>
                A bar with the arrows and the counter, in galleries of more than
                one photo
              </li>
            </ul>
          </figcaption>
        </figure>

        <Section title="Navigation" id="navigation" level={3}>
          <p>
            By default the arrows and the counter sit together in a bar at the
            bottom, easy to reach with a thumb.
          </p>
          <ul class="examples" role="list">
            {navigation.map(({ names, zoom, ...example }) => (
              <Example {...example}>
                <ExamplePhotos names={names} zoom={zoom} />
              </Example>
            ))}
          </ul>
        </Section>

        <Section title="Caption" id="caption" level={3}>
          <p>
            The caption comes from <code>data-image-zoom-caption</code> (or the{" "}
            <code>title</code> of a <code>data-image-zoom</code> link), and sits
            at the bottom by default.
          </p>
          <ul class="examples" role="list">
            {captions.map(({ names, zoom, ...example }) => (
              <Example {...example}>
                <ExamplePhotos names={names} zoom={zoom} />
              </Example>
            ))}
          </ul>
        </Section>

        <Section title="Spacing and controls" id="layout-variables" level={3}>
          <ul class="examples" role="list">
            {spacing.map(({ names, zoom, ...example }) => (
              <Example {...example}>
                <ExamplePhotos names={names} zoom={zoom} />
              </Example>
            ))}
          </ul>
          <Reference rows={layoutVariables} />
        </Section>

        <Section title="Screen sizes" id="responsive" level={3}>
          <p>
            On screens up to 640px wide the overlay makes its buttons, its
            distance to the edges and the caption text smaller, and lets the
            caption take the whole width. A variable you set wins on every
            screen: <code>--zoom-button-size: 56px</code> keeps 56px buttons on
            a phone too. Keep the large values for wide screens with a media
            query, or let them grow with the screen with <code>clamp()</code>.
          </p>
          <CodeSample
            open
            lang="css"
            code={`/* <ImageZoom class="gallery"> */
.gallery {
  --zoom-padding: clamp(12px, 5vw, 64px);
}

@media (width > 640px) {
  .gallery {
    --zoom-button-size: 56px;
    --zoom-controls-offset: 32px;
  }
}`}
          />
          <p>
            The overlay copies your values each time a gallery opens: when a
            media query changes them, as when the phone turns with a photo open,
            the new ones apply from the next opening. The overlay's own smaller
            defaults follow the screen at once.
          </p>
        </Section>
      </Section>

      <Section title="Theming" id="theming">
        <p>
          The overlay follows the light or dark preference of the system. Change
          its colors for one gallery with the <code>theme</code> prop or with
          CSS variables around it, or for the whole site with the same variables
          on <code>:root</code>.
        </p>

        <Section title="Playground" id="playground" level={3}>
          <p>
            Change a value and open a photo. The code to copy updates as you go;
            the variables only apply to this gallery.
          </p>
          <CssPlayground images={["crab", "spirograph"]} />
        </Section>

        <Section title="The theme prop" id="theme-prop" level={3}>
          <div class="theme-example">
            <ImageZoom
              theme={{
                backgroundColor: "light-dark(#d6e6ff, #0b2150)",
                closeButtonColor: "light-dark(#0b3d91, #9cd0ff)",
                navigationColor: "light-dark(#0b3d91, #9cd0ff)",
              }}
            >
              <Photo
                name="ngc3274"
                width={452}
                height={339}
                sizes="(min-width: 64rem) min(35vw, 452px), (min-width: 36rem) 45vw, 90vw"
              />
            </ImageZoom>
            <CodeSample
              open
              code={`<ImageZoom theme={{
  backgroundColor: 'light-dark(#d6e6ff, #0b2150)',
  closeButtonColor: 'light-dark(#0b3d91, #9cd0ff)',
  navigationColor: 'light-dark(#0b3d91, #9cd0ff)',
}}>
  …
</ImageZoom>`}
            />
          </div>
        </Section>

        <Section title="CSS variables" id="css-variables" level={3}>
          <p>
            When a gallery opens, the overlay takes the <code>--zoom-*</code>{" "}
            values found around it. The
            <code>theme</code> prop wins over them.
          </p>
          <CodeSample
            open
            lang="css"
            code={`/* The whole site */
:root {
  --zoom-bg: rgb(5 8 20 / 0.97);
}

/* One gallery: <ImageZoom class="portfolio"> */
.portfolio {
  --zoom-padding: 5vmin;
  --zoom-image-radius: 12px;
}`}
          />
          <h4>Colors</h4>
          <Reference rows={colorVariables} />
          <h4>Color scheme and motion</h4>
          <Reference rows={otherVariables} />
          <p>
            The layout variables are listed under{" "}
            <a href="#layout-variables">Spacing and controls</a>.
          </p>
        </Section>

        <Section title="Parts" id="parts" level={3}>
          <p>
            The overlay lives in a shadow root, so the CSS of your site can't
            break it: generic rules such as{" "}
            <code>{`button { all: unset }`}</code> or{" "}
            <code>{`svg { width: 1em }`}</code> never reach it. The variables
            cross into it; for anything else, style its parts with
            <code>::part()</code>.
          </p>
          <CodeSample
            open
            lang="css"
            code={`astro-image-zoom-overlay::part(caption) {
  text-transform: uppercase;
}`}
          />
          <Reference rows={parts} />
          <p>
            See the zoom{" "}
            <a href={`${base}defaults/`}>with its default styles</a>, and with
            hostile CSS that breaks the rest of the page.
          </p>
        </Section>
      </Section>

      <Section title="Labels" id="labels">
        <p>
          Apart from the counter, which is only numbers, the texts the component
          adds are <code>aria-label</code>s, read by screen readers. They are in
          English; the <code>labels</code> prop translates the ones you set. The
          caption is your own text, so the component never translates it.
        </p>
        <CodeSample
          open
          code={`<ImageZoom labels={{ close: 'Cerrar zoom', enlargeNamed: 'Ampliar imagen: {alt}' }}>
  <img src="/photo.jpg" alt="Un coche rojo" />
</ImageZoom>`}
        />
        <Reference rows={labels} />
        <p>
          For a multilingual site, wrap the component in one of your own that
          picks the labels of the page's locale:
        </p>
        <CodeSample
          code={`---
// src/components/Zoom.astro
import ImageZoom from 'astro-image-zoom/ImageZoom.astro';
import type { ImageZoomLabels } from 'astro-image-zoom';

const translations: Record<string, Partial<ImageZoomLabels>> = {
  es: { close: 'Cerrar zoom', enlargeNamed: 'Ampliar imagen: {alt}' },
};
---
<ImageZoom {...Astro.props} labels={translations[Astro.currentLocale ?? '']}>
  <slot />
</ImageZoom>`}
        />
      </Section>

      <Section title="Events" id="events">
        <p>
          Each <code>{`<astro-image-zoom>`}</code> dispatches an event when the
          zoom opens, moves to another image and closes, for analytics or to
          sync something else on the page. They bubble, so one listener on the
          document hears every gallery. Open a photo and watch the log.
        </p>
        <EventsConsole names={["saturnShadow", "saturn", "pluto"]} />
        <CodeSample
          open
          code={`<script>
  document.addEventListener('astro-image-zoom:open', (event) => {
    const { index, total, src } = event.detail;
    console.log(\`Opened \${index + 1} of \${total}: \${src}\`);
  });

  // Only one gallery: listen on its element instead
  document.querySelector('.portfolio')?.addEventListener('astro-image-zoom:change', (event) => {
    console.log('Now showing', event.detail.caption);
  });
</script>`}
        />
        <Reference rows={events} />
        <h3>Event detail</h3>
        <p>
          Every event carries the image on screen in its <code>detail</code>,
          typed as <code>ZoomEventDetail</code>.
        </p>
        <Reference rows={eventDetail} />
      </Section>

      <Section title="JavaScript API" id="javascript-api">
        <p>
          For images outside any <code>{`<ImageZoom>`}</code>, such as markup
          your scripts add after the page loads, create a zoom with{" "}
          <code>ZoomClass</code> on the element around the links. Images aren't
          wrapped then, so only links with <code>data-image-zoom</code> count.
          Inside an <code>{`<ImageZoom>`}</code> you don't need it: links with{" "}
          <code>data-image-zoom</code> added later are picked up when clicked.
        </p>
        <CodeSample
          open
          code={`<div class="my-gallery">
  <a href="/large-1.jpg" data-image-zoom><img src="/small-1.jpg" alt="Harbor at dawn" /></a>
  <a href="/large-2.jpg" data-image-zoom><img src="/small-2.jpg" alt="Harbor at noon" /></a>
</div>

<script>
  import { ZoomClass } from 'astro-image-zoom';

  const gallery = document.querySelector<HTMLElement>('.my-gallery');
  if (gallery) {
    const zoom = new ZoomClass(gallery);
    // Later, if needed: zoom.destroy();
  }
</script>`}
        />
        <p>
          It reads the options from the same <code>data-*</code> attributes{" "}
          <code>{`<ImageZoom>`}</code> renders on its element, such as
          <code>data-image-zoom-show-counter="false"</code>; the theme and the
          duration come from the <code>--zoom-*</code> variables.
          <code>data-image-zoom-ignore-selector</code> on the wrapper takes any
          CSS selector, since the browser matches it.
        </p>
      </Section>

      <Section title="Reference" id="reference">
        <h3>Props</h3>
        <Reference rows={props} />

        <h3>Image attributes</h3>
        <Reference rows={attributes} />
      </Section>
    </article>
  </div>
</Layout>

