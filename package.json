{
  "name": "astro-image-zoom-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace for astro-image-zoom component development",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter astro-image-zoom-demo dev",
    "build": "pnpm --filter astro-image-zoom-demo build",
    "preview": "pnpm --filter astro-image-zoom-demo preview",
    "check": "pnpm --filter astro-image-zoom check",
    "test": "pnpm --filter astro-image-zoom test",
    "test:e2e": "pnpm --filter astro-image-zoom test:e2e",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "devDependencies": {
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0"
  }
}
