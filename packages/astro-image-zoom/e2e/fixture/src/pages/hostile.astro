---
/**
 * The zoom next to aggressive CSS: unlayered rules with !important that would break a normal
 * component. Off by default, on with ?hostile. The overlay must look the same either way.
 * The first image is optimized by Astro, with a full-size version in data-zoom-src.
 */
import { Image, getImage } from "astro:assets";
import ImageZoom from "astro-image-zoom/ImageZoom.astro";
import earth from "../assets/earth.jpg";

const full = await getImage({ src: earth, width: earth.width, format: "webp" });
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hostile CSS · astro-image-zoom</title>
    <style is:inline id="hostile" media="not all">
      html { font-size: 8px !important; }
      body { color: red !important; letter-spacing: 4px !important; line-height: 3 !important; text-transform: uppercase !important; cursor: crosshair !important; }
      * { transition: all 2s !important; box-sizing: content-box !important; }
      button { all: unset !important; background: red !important; color: red !important; }
      svg { display: none !important; width: 1em !important; fill: red !important; stroke: none !important; }
      path { stroke: transparent !important; }
      img { border-radius: 50% !important; filter: grayscale(1) !important; opacity: 0.6 !important; }
      p { font-size: 32px !important; color: red !important; }
      span { display: none !important; }
      div { padding: 40px !important; border: 2px dashed red !important; }
      figure { margin: 80px !important; }
      dialog { background: red !important; border: 10px solid lime !important; max-width: 200px !important; }
      dialog::backdrop { background: red !important; }
      [hidden] { display: block !important; }
    </style>
    <script is:inline>
      if (new URLSearchParams(location.search).has("hostile")) {
        document.getElementById("hostile").media = "all";
      }
    </script>
  </head>
  <body>
    <main>
      <h1>Hostile CSS</h1>
      <ImageZoom>
        <Image
          src={earth}
          alt="Earth seen from Apollo 17"
          width={320}
          data-zoom-src={full.src}
          data-zoom-caption="The Blue Marble"
        />
        <img src={`${base}images/square.svg`} alt="Green square" width="240" data-zoom-caption="A square" />
      </ImageZoom>
    </main>
  </body>
</html>
