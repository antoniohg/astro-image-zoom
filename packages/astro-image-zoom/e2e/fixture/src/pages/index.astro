---
/**
 * One <ImageZoom> per case, each in a section with a stable id that the tests use. No site CSS and
 * plain SVG images from public/images/.
 */
import ImageZoom from "astro-image-zoom/ImageZoom.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const image = (name: string) => `${base}images/${name}.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fixtures · astro-image-zoom</title>
    <style>
      img {
        width: 240px;
        height: auto;
      }

      section {
        margin-block: 2rem;
      }

      /* Room to scroll, for the scroll-close tests */
      main {
        padding-block-end: 150vh;
      }
    </style>
    <!-- A site that lays out a gallery from a cascade layer, on the element of the component itself -->
    <style is:inline>
      @layer site {
        .site-grid {
          display: grid;
          grid-template-columns: repeat(2, 240px);
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Fixtures</h1>

      <section id="single">
        <h2>One image</h2>
        <ImageZoom>
          <img
            src={image("landscape")}
            alt="Blue landscape"
            data-image-zoom-caption="A single image"
          />
        </ImageZoom>
      </section>

      <section id="gallery">
        <h2>Gallery</h2>
        <ImageZoom>
          <img
            src={image("portrait")}
            alt="Pink portrait"
            data-image-zoom-caption="First"
          />
          <img
            src={image("square")}
            alt="Green square"
            data-image-zoom-caption="Second"
          />
          <img
            src={image("wide")}
            alt="Orange panorama"
            data-image-zoom-caption="Third"
          />
        </ImageZoom>
      </section>

      <section id="card-link">
        <h2>A normal link with an image</h2>
        <ImageZoom>
          <img src={image("wide")} alt="Zoomable panorama" />
          <a href={`${base}hostile/`}>
            <img src={image("square")} alt="Card linking to another page" />
          </a>
        </ImageZoom>
      </section>

      <section id="text-link">
        <h2>A data-image-zoom link without an image</h2>
        <ImageZoom>
          <img src={image("portrait")} alt="Zoomable portrait" />
          <a href={image("wide")} data-image-zoom>
            Open the panorama
          </a>
        </ImageZoom>
      </section>

      <section id="sources">
        <h2>Zoom sources</h2>
        <ImageZoom>
          <img
            src={image("square")}
            data-image-zoom-src={image("landscape")}
            alt="Thumbnail with data-image-zoom-src"
          />
          <a href={image("wide")} data-image-zoom>
            <img src={image("portrait")} alt="Thumbnail in a link" />
          </a>
        </ImageZoom>
      </section>

      <section id="theme">
        <h2>Theme and duration props</h2>
        <ImageZoom
          theme={{
            backgroundColor: "rgb(5, 10, 26)",
            closeButtonColor: "rgb(142, 203, 255)",
          }}
          animationDuration={800}
        >
          <img src={image("square")} alt="Themed square" />
        </ImageZoom>
      </section>

      <section
        id="variables"
        style="--zoom-image-radius: 16px; --zoom-padding: 40px; --zoom-bg: rgb(30, 0, 40);"
      >
        <h2>Variables around the gallery</h2>
        <ImageZoom>
          <img src={image("landscape")} alt="Landscape with variables" />
        </ImageZoom>
      </section>

      <section id="no-close">
        <h2>No close on backdrop or image</h2>
        <ImageZoom
          closeOnBackdrop={false}
          closeOnImage={false}
          closeOnScroll={false}
        >
          <img src={image("portrait")} alt="Portrait that stays open" />
        </ImageZoom>
      </section>

      <section id="layout">
        <h2>Caption at the top, arrows at the sides</h2>
        <ImageZoom captionPosition="top" navigationLayout="sides">
          <img
            src={image("landscape")}
            alt="Landscape one"
            data-image-zoom-caption="Top caption"
          />
          <img
            src={image("square")}
            alt="Square two"
            data-image-zoom-caption="Top caption two"
          />
        </ImageZoom>
      </section>

      <section id="fit">
        <h2>Thumbnail cropped twice</h2>
        <!-- A landscape file of a portrait image, covering a portrait box. The animation is slow so
             the test can read it while it runs -->
        <ImageZoom animationDuration={60000}>
          <img
            src={image("landscape")}
            data-image-zoom-src={image("portrait")}
            style="width: 150px; height: 200px; object-fit: cover"
            alt="Landscape thumbnail of a portrait image"
          />
        </ImageZoom>
      </section>

      <section id="hidden">
        <h2>No caption, no counter</h2>
        <ImageZoom showCaption={false} showCounter={false}>
          <img
            src={image("wide")}
            alt="Wide one"
            data-image-zoom-caption="Hidden caption"
          />
          <img
            src={image("portrait")}
            alt="Portrait two"
            data-image-zoom-caption="Hidden caption two"
          />
        </ImageZoom>
      </section>

      <section id="ignore">
        <h2>Images left out with the ignore prop and data-image-zoom-ignore</h2>
        <ImageZoom ignore=".logo, [alt='']">
          <img src={image("square")} alt="Kept one" />
          <img class="logo" src={image("wide")} alt="Logo" />
          <img src={image("wide")} alt="" />
          <img
            src={image("wide")}
            alt="Marked by hand"
            data-image-zoom-ignore
          />
          <div data-image-zoom-ignore>
            <img src={image("portrait")} alt="Ignored by its parent" />
            <a href={image("portrait")} data-image-zoom>
              <img src={image("portrait")} alt="Ignored link" />
            </a>
          </div>
          <img src={image("landscape")} alt="Kept two" />
        </ImageZoom>
      </section>

      <section id="caption-fallbacks">
        <h2>Captions from the title and the figcaption</h2>
        <ImageZoom>
          <!-- What Markdown renders for ![alt](src "title") -->
          <img
            src={image("square")}
            alt="Square with a title"
            title="Title of the image"
          />
          <figure>
            <img
              src={image("wide")}
              alt="Wide in a figure"
              title="Loses to the figcaption"
            />
            <figcaption>
              Caption of the <em>figure</em>
            </figcaption>
          </figure>
          <figure>
            <img
              src={image("landscape")}
              alt="Explicit caption in a figure"
              data-image-zoom-caption="Explicit caption"
            />
            <figcaption>Loses to the explicit caption</figcaption>
          </figure>
          <figure>
            <img src={image("portrait")} alt="One of two in a figure" />
            <img src={image("square")} alt="Two of two in a figure" />
            <figcaption>Shared by two images</figcaption>
          </figure>
          <img
            src={image("wide")}
            alt="No caption on purpose"
            title="Only a tooltip"
            data-image-zoom-caption=""
          />
        </ImageZoom>
      </section>

      <section id="site-layout">
        <h2>Laid out by the site</h2>
        <ImageZoom class="site-grid">
          <img src={image("square")} alt="Square in a grid" />
          <img src={image("landscape")} alt="Landscape in a grid" />
        </ImageZoom>
      </section>

      <section id="zoom-class">
        <h2>ZoomClass on markup without ImageZoom</h2>
        <div class="standalone" data-image-zoom-show-counter="false">
          <a href={image("landscape")} data-image-zoom>
            <img src={image("landscape")} alt="Standalone one" />
          </a>
          <a href={image("portrait")} data-image-zoom>
            <img src={image("portrait")} alt="Standalone two" />
          </a>
        </div>
      </section>
    </main>
    <script>
      import { ZoomClass } from "astro-image-zoom";

      new ZoomClass(
        document.querySelector<HTMLElement>("#zoom-class .standalone")!,
      );
    </script>
  </body>
</html>
