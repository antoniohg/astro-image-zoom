---
/**
 * <ImageZoom> for Starlight: the options of the plugin, the labels of the page's language and
 * Starlight's colors. The plugin's MarkdownContent override uses it, and so can a site's own
 * override, around Starlight's MarkdownContent
 */
import options from "virtual:astro-image-zoom/starlight-config";
import ImageZoom from "../ImageZoom.astro";
import { DEFAULT_LABELS, type ImageZoomLabels } from "../labels";

// Starlight's translation function, typed here so the package does not rely on Starlight's
// global types
type Key = `astroImageZoom.${keyof ImageZoomLabels}`;
const { t } = Astro.locals as unknown as {
  t: ((key: Key) => string) & { exists: (key: Key) => boolean };
};
// Starlight falls back to the site's default language, not to English: on a site whose default
// language the plugin does not translate, a missing key would come back as the key itself
const labels: ImageZoomLabels = { ...DEFAULT_LABELS };
for (const key of Object.keys(labels) as (keyof ImageZoomLabels)[]) {
  if (t.exists(`astroImageZoom.${key}`))
    labels[key] = t(`astroImageZoom.${key}`);
}
---

<ImageZoom {...options} labels={labels}>
  <slot />
</ImageZoom>

<style is:global>
  /* Starlight's palette as the default --image-zoom-* colors, in the image-zoom cascade layer and
     at zero specificity (:where()), so any rule of the site wins, and the theme option, inline on
     the element, wins over both. The var()s resolve on :root, where Starlight switches its tokens
     with the theme */
  @layer image-zoom {
    :where(:root) {
      --image-zoom-bg: var(--sl-color-black);
      --image-zoom-close-color: var(--sl-color-white);
      --image-zoom-close-bg: color-mix(
        in srgb,
        var(--sl-color-gray-6) 80%,
        transparent
      );
      --image-zoom-nav-color: var(--sl-color-white);
      --image-zoom-nav-bg: color-mix(
        in srgb,
        var(--sl-color-gray-6) 80%,
        transparent
      );
      --image-zoom-caption-color: var(--sl-color-white);
      --image-zoom-caption-bg: color-mix(
        in srgb,
        var(--sl-color-gray-6) 80%,
        transparent
      );
    }

    /* Starlight puts the theme on screen in data-theme, from its toggle or the OS. The overlay's
       own light and dark details follow it, not the OS */
    :where(:root[data-theme="light"]) {
      --image-zoom-color-scheme: light;
    }
    :where(:root[data-theme="dark"]) {
      --image-zoom-color-scheme: dark;
    }
  }
</style>
