---
/**
 * ImageZoom component for Astro
 * Medium-style zoom overlay with accessibility and performance features
 */

// Global stylesheet: selectors are prefixed and live in @layer astro-image-zoom
import "./zoom.css";
import { wrapImages } from "./wrapImages";

export interface Props {
  /**
   * Theme configuration
   */
  theme?: {
    backgroundColor?: string;
    closeButtonColor?: string;
    navigationColor?: string;
  };

  /**
   * Animation duration in milliseconds
   */
  animationDuration?: number;

  /**
   * Enable keyboard navigation
   */
  keyboardNavigation?: boolean;

  /**
   * Close on backdrop click
   */
  closeOnBackdrop?: boolean;

  /**
   * Close on image click
   */
  closeOnImage?: boolean;

  /**
   * Close on scroll/wheel
   */
  closeOnScroll?: boolean;

  /**
   * Show navigation arrows for galleries
   */
  showNavigation?: boolean;

  /**
   * Custom CSS class for the zoom container
   */
  class?: string;

  /**
   * Unique ID for this zoom instance
   */
  id?: string;
}

const {
  theme = {},
  animationDuration = 300,
  keyboardNavigation = true,
  closeOnBackdrop = true,
  closeOnImage = true,
  closeOnScroll = true,
  showNavigation = true,
  class: className = "",
  id = "astro-image-zoom",
} = Astro.props;

// Store theme config as data attributes to be read by JS
const themeConfig = JSON.stringify(theme);
const wrapperClasses = ["astro-image-zoom-wrapper", className]
  .filter(Boolean)
  .join(" ");

// Wrap the slot's images in accessible links
const slotContent = wrapImages(await Astro.slots.render("default"));
---

<astro-image-zoom
  class={wrapperClasses}
  data-zoom-id={id}
  data-keyboard={keyboardNavigation ? "true" : "false"}
  data-close-backdrop={closeOnBackdrop ? "true" : "false"}
  data-close-image={closeOnImage ? "true" : "false"}
  data-close-scroll={closeOnScroll ? "true" : "false"}
  data-show-nav={showNavigation ? "true" : "false"}
  data-theme-config={themeConfig}
  data-animation-duration={animationDuration}
>
  <Fragment set:html={slotContent} />
</astro-image-zoom>

<script>
  import { Zoom } from "./zoom";

  // Each <astro-image-zoom> gets its own Zoom instance; they share one overlay,
  // which zoom.ts creates on first use.
  class AstroImageZoomElement extends HTMLElement {
    private zoom: Zoom | null = null;

    connectedCallback() {
      this.zoom = new Zoom(this);
    }

    disconnectedCallback() {
      this.zoom?.destroy();
      this.zoom = null;
    }
  }

  // Register custom element (only runs once even with multiple instances)
  if (!customElements.get("astro-image-zoom")) {
    customElements.define("astro-image-zoom", AstroImageZoomElement);
  }
</script>
