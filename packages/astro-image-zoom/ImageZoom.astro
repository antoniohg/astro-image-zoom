---
/**
 * ImageZoom component for Astro
 * Medium-style zoom overlay with accessibility and performance features
 */

import { parseIgnore, wrapImages } from "./wrapImages";
import { DEFAULT_LABELS, type ImageZoomLabels } from "./labels";

export interface Props {
  /**
   * Colors of the overlay; each one sets a --image-zoom-* variable and wins over it
   */
  theme?: {
    /** Overlay background (--image-zoom-bg) */
    backgroundColor?: string;
    /** Close icon (--image-zoom-close-color) */
    closeButtonColor?: string;
    /** Close button (--image-zoom-close-bg) */
    closeButtonBackground?: string;
    /** Arrows and counter (--image-zoom-nav-color) */
    navigationColor?: string;
    /** Navigation bar, or each arrow in the sides layout (--image-zoom-nav-bg) */
    navigationBackground?: string;
    /** Caption text (--image-zoom-caption-color) */
    captionColor?: string;
    /** Caption box (--image-zoom-caption-bg) */
    captionBackground?: string;
  };

  /**
   * Animation duration in milliseconds. Without it, the duration comes from the
   * --image-zoom-animation-duration CSS variable (300ms by default)
   */
  animationDuration?: number;

  /**
   * How the image opens and closes: "zoom" grows it from its thumbnail and shrinks it back,
   * "fade" fades it in and out where it lands
   */
  animation?: "zoom" | "fade";

  /**
   * Close on backdrop click
   */
  closeOnBackdrop?: boolean;

  /**
   * Close on image click
   */
  closeOnImage?: boolean;

  /**
   * Close on scroll/wheel
   */
  closeOnScroll?: boolean;

  /**
   * Show navigation arrows for galleries
   */
  showNavigation?: boolean;

  /**
   * Navigation arrows in a bar at the bottom, with the counter, or at the sides of the screen
   */
  navigationLayout?: "bar" | "sides";

  /**
   * Show the position in the gallery, such as "3 / 8"
   */
  showCounter?: boolean;

  /**
   * Show the caption of the zoomed image
   */
  showCaption?: boolean;

  /**
   * Where the caption sits: at the bottom or the top of the screen
   */
  captionPosition?: "bottom" | "top";

  /**
   * Texts read by assistive technology, in English by default: set the ones to translate
   */
  labels?: Partial<ImageZoomLabels>;

  /**
   * Images left out of the zoom and the gallery: simple selectors separated by commas, matched
   * against each image and the elements around it, such as ".logo, .avatar, [alt='']"
   */
  ignore?: string;

  /**
   * Custom CSS class for the zoom container
   */
  class?: string;
}

const {
  theme = {},
  animationDuration,
  animation = "zoom",
  closeOnBackdrop = true,
  closeOnImage = true,
  closeOnScroll = true,
  showNavigation = true,
  navigationLayout = "bar",
  showCounter = true,
  showCaption = true,
  captionPosition = "bottom",
  labels = {},
  ignore = "",
  class: className = "",
} = Astro.props;

// The theme and the duration become --image-zoom-* variables on the element, which the overlay
// copies when it opens: they win over the variables of the site, set on this element or around it
const variables = Object.entries({
  "--image-zoom-bg": theme.backgroundColor,
  "--image-zoom-close-color": theme.closeButtonColor,
  "--image-zoom-close-bg": theme.closeButtonBackground,
  "--image-zoom-nav-color": theme.navigationColor,
  "--image-zoom-nav-bg": theme.navigationBackground,
  "--image-zoom-caption-color": theme.captionColor,
  "--image-zoom-caption-bg": theme.captionBackground,
  "--image-zoom-animation-duration":
    animationDuration === undefined ? undefined : `${animationDuration}ms`,
})
  .filter(([, value]) => value)
  .map(([name, value]) => `${name}: ${value}`)
  .join("; ");

// The link labels are used here, on the server; the overlay only needs the others
const { enlarge, enlargeNamed, ...overlayLabels } = labels;

// Wrap the slot's images in accessible links
const slotContent = wrapImages(
  await Astro.slots.render("default"),
  parseIgnore(ignore),
  { ...DEFAULT_LABELS, ...labels },
);

// The element only groups its content and must not add a box. Its own declarative shadow root says
// so, with no stylesheet on the page: any rule of the site, layered or not, wins over :host. A string,
// since Astro would take <slot> for its own
const shadowRoot =
  '<template shadowrootmode="open"><style>@layer image-zoom { :host { display: contents; } }</style><slot></slot></template>';
---

<astro-image-zoom
  class={className || undefined}
  data-image-zoom-animation={animation}
  data-image-zoom-close-backdrop={String(closeOnBackdrop)}
  data-image-zoom-close-image={String(closeOnImage)}
  data-image-zoom-close-scroll={String(closeOnScroll)}
  data-image-zoom-show-nav={String(showNavigation)}
  data-image-zoom-navigation-layout={navigationLayout}
  data-image-zoom-show-counter={String(showCounter)}
  data-image-zoom-show-caption={String(showCaption)}
  data-image-zoom-caption-position={captionPosition}
  data-image-zoom-ignore-selector={ignore.trim() || undefined}
  style={variables || undefined}
  data-image-zoom-labels={
    Object.keys(overlayLabels).length
      ? JSON.stringify(overlayLabels)
      : undefined
  }
>
  <Fragment set:html={shadowRoot + slotContent} />
</astro-image-zoom>

<script>
  import { Zoom } from "./zoom";

  // Each <astro-image-zoom> gets its own Zoom instance; they share one overlay,
  // which zoom.ts creates on first use.
  class AstroImageZoomElement extends HTMLElement {
    private zoom: Zoom | null = null;

    connectedCallback() {
      // The browser attaches the declarative shadow root while parsing, but not in pages parsed
      // with DOMParser, as the client router of Astro does: attach it from the template then
      if (!this.shadowRoot) {
        const template = this.querySelector<HTMLTemplateElement>(
          ":scope > template[shadowrootmode]",
        );
        if (template) {
          this.attachShadow({ mode: "open" }).append(
            template.content.cloneNode(true),
          );
          template.remove();
        }
      }
      this.zoom = new Zoom(this);
    }

    disconnectedCallback() {
      this.zoom?.destroy();
      this.zoom = null;
    }
  }

  // Register custom element (only runs once even with multiple instances)
  if (!customElements.get("astro-image-zoom")) {
    customElements.define("astro-image-zoom", AstroImageZoomElement);
  }
</script>
