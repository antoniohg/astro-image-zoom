---
/**
 * ImageZoom component for Astro
 * Medium-style zoom overlay with accessibility and performance features
 */

import { parseIgnore, wrapImages } from "./wrapImages";

export interface Props {
  /**
   * Colors of the overlay; each one sets a --zoom-* variable and wins over it
   */
  theme?: {
    /** Overlay background (--zoom-bg) */
    backgroundColor?: string;
    /** Close icon (--zoom-close-color) */
    closeButtonColor?: string;
    /** Close button (--zoom-close-bg) */
    closeButtonBackground?: string;
    /** Arrows and counter (--zoom-nav-color) */
    navigationColor?: string;
    /** Navigation bar, or each arrow in the sides layout (--zoom-nav-bg) */
    navigationBackground?: string;
    /** Caption text (--zoom-caption-color) */
    captionColor?: string;
    /** Caption box (--zoom-caption-bg) */
    captionBackground?: string;
  };

  /**
   * Animation duration in milliseconds. Without it, the duration comes from the
   * --zoom-animation-duration CSS variable (300ms by default)
   */
  animationDuration?: number;

  /**
   * Close on backdrop click
   */
  closeOnBackdrop?: boolean;

  /**
   * Close on image click
   */
  closeOnImage?: boolean;

  /**
   * Close on scroll/wheel
   */
  closeOnScroll?: boolean;

  /**
   * Show navigation arrows for galleries
   */
  showNavigation?: boolean;

  /**
   * Navigation arrows in a bar at the bottom, with the counter, or at the sides of the screen
   */
  navigationLayout?: "bar" | "sides";

  /**
   * Show the position in the gallery, such as "3 / 8"
   */
  showCounter?: boolean;

  /**
   * Show the caption of the zoomed image
   */
  showCaption?: boolean;

  /**
   * Where the caption sits: at the bottom or the top of the screen
   */
  captionPosition?: "bottom" | "top";

  /**
   * Images left out of the zoom and the gallery: simple selectors separated by commas, matched
   * against each image and the elements around it, such as ".logo, .avatar, [alt='']"
   */
  ignore?: string;

  /**
   * Custom CSS class for the zoom container
   */
  class?: string;
}

const {
  theme = {},
  animationDuration,
  closeOnBackdrop = true,
  closeOnImage = true,
  closeOnScroll = true,
  showNavigation = true,
  navigationLayout = "bar",
  showCounter = true,
  showCaption = true,
  captionPosition = "bottom",
  ignore = "",
  class: className = "",
} = Astro.props;

// The theme and the duration become --zoom-* variables on the element, which the overlay copies
// when it opens: they win over the variables of the site, set on this element or around it
const variables = Object.entries({
  "--zoom-bg": theme.backgroundColor,
  "--zoom-close-color": theme.closeButtonColor,
  "--zoom-close-bg": theme.closeButtonBackground,
  "--zoom-nav-color": theme.navigationColor,
  "--zoom-nav-bg": theme.navigationBackground,
  "--zoom-caption-color": theme.captionColor,
  "--zoom-caption-bg": theme.captionBackground,
  "--zoom-animation-duration":
    animationDuration === undefined ? undefined : `${animationDuration}ms`,
})
  .filter(([, value]) => value)
  .map(([name, value]) => `${name}: ${value}`)
  .join("; ");
const wrapperClasses = ["astro-image-zoom-wrapper", className]
  .filter(Boolean)
  .join(" ");

// Wrap the slot's images in accessible links
const slotContent = wrapImages(
  await Astro.slots.render("default"),
  parseIgnore(ignore),
);

// The element only groups its content and must not add a box. Its own declarative shadow root says
// so, with no stylesheet on the page: any rule of the site, layered or not, wins over :host. A string,
// since Astro would take <slot> for its own
const shadowRoot =
  '<template shadowrootmode="open"><style>:host { display: contents; }</style><slot></slot></template>';
---

<astro-image-zoom
  class={wrapperClasses}
  data-image-zoom-close-backdrop={closeOnBackdrop ? "true" : "false"}
  data-image-zoom-close-image={closeOnImage ? "true" : "false"}
  data-image-zoom-close-scroll={closeOnScroll ? "true" : "false"}
  data-image-zoom-show-nav={showNavigation ? "true" : "false"}
  data-image-zoom-navigation-layout={navigationLayout}
  data-image-zoom-show-counter={showCounter ? "true" : "false"}
  data-image-zoom-show-caption={showCaption ? "true" : "false"}
  data-image-zoom-caption-position={captionPosition}
  data-image-zoom-ignore-selector={ignore.trim() || undefined}
  style={variables || undefined}
>
  <Fragment set:html={shadowRoot + slotContent} />
</astro-image-zoom>

<script>
  import { Zoom } from "./zoom";

  // Each <astro-image-zoom> gets its own Zoom instance; they share one overlay,
  // which zoom.ts creates on first use.
  class AstroImageZoomElement extends HTMLElement {
    private zoom: Zoom | null = null;

    connectedCallback() {
      // The browser attaches the declarative shadow root while parsing, but not in pages parsed
      // with DOMParser, as the client router of Astro does: attach it from the template then
      if (!this.shadowRoot) {
        const template = this.querySelector<HTMLTemplateElement>(
          ":scope > template[shadowrootmode]",
        );
        if (template) {
          this.attachShadow({ mode: "open" }).append(
            template.content.cloneNode(true),
          );
          template.remove();
        }
      }
      this.zoom = new Zoom(this);
    }

    disconnectedCallback() {
      this.zoom?.destroy();
      this.zoom = null;
    }
  }

  // Register custom element (only runs once even with multiple instances)
  if (!customElements.get("astro-image-zoom")) {
    customElements.define("astro-image-zoom", AstroImageZoomElement);
  }
</script>
