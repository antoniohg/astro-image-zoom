---
/**
 * Zoom Component for Astro
 * Medium-style zoom overlay with accessibility and performance features
 */

export interface Props {
  /**
   * Theme configuration
   */
  theme?: {
    backgroundColor?: string;
    closeButtonColor?: string;
    navigationColor?: string;
  };

  /**
   * Animation duration in milliseconds
   */
  animationDuration?: number;

  /**
   * Enable keyboard navigation
   */
  keyboardNavigation?: boolean;

  /**
   * Close on backdrop click
   */
  closeOnBackdrop?: boolean;

  /**
   * Close on image click
   */
  closeOnImage?: boolean;

  /**
   * Close on scroll/wheel
   */
  closeOnScroll?: boolean;

  /**
   * Show navigation arrows for galleries
   */
  showNavigation?: boolean;

  /**
   * Custom CSS class for the zoom container
   */
  class?: string;

  /**
   * Unique ID for this zoom instance
   */
  id?: string;
}

const {
  theme = {},
  animationDuration = 300,
  keyboardNavigation = true,
  closeOnBackdrop = true,
  closeOnImage = true,
  closeOnScroll = true,
  showNavigation = true,
  class: className = "",
  id = "astro-image-zoom",
} = Astro.props;

// Store theme config as data attributes to be read by JS
const themeConfig = JSON.stringify(theme);
const wrapperClasses = ["astro-image-zoom-wrapper", className]
  .filter(Boolean)
  .join(" ");

// Read an attribute from an <img> tag string. The value may contain the other
// quote type (alt="Antonio's photo"); double quotes are escaped so it can be
// written back inside a double-quoted attribute.
const getAttribute = (tag: string, name: string): string | undefined => {
  const match = tag.match(new RegExp(`\\s${name}=(["'])(.*?)\\1`, "i"));
  return match?.[2].replaceAll('"', "&quot;");
};

// Process slot content to wrap images in accessible links
let slotContent = await Astro.slots.render("default");

// Split by <img tags and process each
const parts = slotContent.split(/(<img[^>]*>)/i);
let processedContent = "";

for (let i = 0; i < parts.length; i++) {
  const part = parts[i];

  // Check if this part is an <img> tag
  if (part.match(/^<img/i)) {
    // Count how many <a> and </a> tags are before this
    const beforeThis = parts.slice(0, i).join("");
    const openACount = (beforeThis.match(/<a[\s>]/gi) || []).length;
    const closeACount = (beforeThis.match(/<\/a>/gi) || []).length;

    // If inside an <a> tag (more opens than closes), don't wrap
    if (openACount > closeACount) {
      processedContent += part;
      continue;
    }

    // Extract attributes for the link
    const src = getAttribute(part, "src");
    const zoomSrc = getAttribute(part, "data-zoom-src");
    const captionText = getAttribute(part, "data-zoom-caption");
    const altText = getAttribute(part, "alt");

    if (!src) {
      processedContent += part;
      continue;
    }

    const href = zoomSrc || src;
    const caption = captionText ? ` data-zoom-caption="${captionText}"` : "";

    // The link is named after the image so screen readers announce what opens
    const ariaLabel = altText ? `Enlarge image: ${altText}` : "Enlarge image";

    processedContent += `<a href="${href}" data-zoom-generated${caption} aria-label="${ariaLabel}">${part}</a>`;
  } else {
    processedContent += part;
  }
}

slotContent = processedContent;
---

<astro-image-zoom
  class={wrapperClasses}
  data-zoom-id={id}
  data-keyboard={keyboardNavigation ? "true" : "false"}
  data-close-backdrop={closeOnBackdrop ? "true" : "false"}
  data-close-image={closeOnImage ? "true" : "false"}
  data-close-scroll={closeOnScroll ? "true" : "false"}
  data-show-nav={showNavigation ? "true" : "false"}
  data-theme-config={themeConfig}
  data-animation-duration={animationDuration}
>
  <Fragment set:html={slotContent} />
</astro-image-zoom>

<!-- Global Zoom Overlay (shared across all zoom instances) -->
<dialog
  id="astro-image-zoom-global-overlay"
  class="astro-image-zoom-overlay"
  aria-label="Image zoom overlay"
>
  <div class="astro-image-zoom-backdrop" aria-hidden="true"></div>
  <div class="astro-image-zoom-content" role="document">
    <button
      class="astro-image-zoom-close"
      aria-label="Close zoom overlay"
      type="button"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M18 6L6 18M6 6L18 18"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
    <button
      class="astro-image-zoom-nav astro-image-zoom-prev"
      aria-label="Previous image"
      type="button"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M15 18L9 12L15 6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
    <button
      class="astro-image-zoom-nav astro-image-zoom-next"
      aria-label="Next image"
      type="button"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M9 18L15 12L9 6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
    <figure class="astro-image-zoom-figure">
      <img class="astro-image-zoom-image" src="" alt="" loading="eager" />
      <figcaption class="astro-image-zoom-caption" aria-live="polite"></figcaption>
    </figure>
  </div>
</dialog>

<script>
  import { Zoom } from "./zoom";

  // Ensure overlay is at the end of body and remove any duplicates
  function initGlobalOverlay() {
    const overlays = document.querySelectorAll("#astro-image-zoom-global-overlay");
    if (overlays.length === 0) return;
    
    // Keep only the first overlay, move to body end
    const [firstOverlay, ...duplicates] = Array.from(overlays);
    
    if (firstOverlay.parentElement !== document.body) {
      document.body.appendChild(firstOverlay);
    }
    
    // Remove duplicates efficiently
    for (const overlay of duplicates) {
      overlay.remove();
    }
  }

  // Run on initial load
  initGlobalOverlay();

  // Define custom element for astro-image-zoom
  class AstroImageZoomElement extends HTMLElement {
    private zoom: Zoom | null = null;

    connectedCallback() {
      // Ensure overlay is ready before initializing
      if (!document.getElementById("astro-image-zoom-global-overlay")) {
        initGlobalOverlay();
      }
      this.zoom = new Zoom(this);
    }

    disconnectedCallback() {
      this.zoom?.destroy();
      this.zoom = null;
    }
  }

  // Register custom element (only runs once even with multiple instances)
  if (!customElements.get("astro-image-zoom")) {
    customElements.define("astro-image-zoom", AstroImageZoomElement);
  }
</script>

<style>
  @import "./zoom.css";
</style>
